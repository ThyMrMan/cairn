# Container scripts must keep LF; CRLF makes the shebang unparseable and the
# container dies with an inscrutable "no such file or directory".
*.sh            text eol=lf
docker/rootfs/** text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.css           text eol=lf
*.json          text eol=lf
*.md            text eol=lf

*.png binary
*.svg text eol=lf
*.warc binary
*.warc.gz binary
