# Local development settings. Copy to .env — it is gitignored.
#
# The defaults in config.py target the container (/config, /data). For local
# development point them at .local/ inside the repo.
#
# Deliberately NOT ./config and ./data: docker-compose bind-mounts those, and
# sharing one state directory between a local dev server and a container means
# they see each other's database. The symptom is a "fresh" container that
# already has an account and shows Sign In instead of the setup page.

CAIRN_CONFIG_DIR=./.local/config
CAIRN_DATA_DIR=./.local/data

# Generate with: openssl rand -base64 48
#
# Optional for the local dev server (one is generated into
# .local/config/secret.key on first run), but REQUIRED for docker-compose,
# which reads this same file to interpolate the compose config and refuses to
# start without it. Losing it makes stored cookie jars unrecoverable.
# CAIRN_SECRET_KEY=

CAIRN_LOG_JSON=false
CAIRN_LOG_LEVEL=DEBUG
CAIRN_DEV_MODE=true

# Public origins. These MUST differ in hostname, not just port — ports do not
# isolate cookies, so archived JavaScript on a shared host can read your
# session. Leave unset for localhost development.
# CAIRN_APP_PUBLIC_URL=https://archive.example.com
# CAIRN_REPLAY_PUBLIC_URL=https://replay.example.com
